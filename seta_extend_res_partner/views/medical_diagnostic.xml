<odoo>
    <record id="medical_diagnostic_view_form" model="ir.ui.view">
        <field name="name">medical.diagnostic.form</field>
        <field name="model">medical.diagnostic</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="res_partner_id"/>
                            <field name="name"/>
                            <field name="type_medical_diagnostic_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="diagnostic" string="Diagnostic">
                            <group>
                                <group>
                                    <field name="diagnostic_date"/>
                                    <field name="diagnosis"/>
                                    <field name="applied_techniques"/>
                                    <field name="result"/>
                                    <field name="professional"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="medical_diagnostic_view_tree" model="ir.ui.view">
        <field name="name">medical.diagnostic.view.tree</field>
        <field name="model">medical.diagnostic</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="res_partner_id"/>
                <field name="type_medical_diagnostic_id"/>
            </tree>
        </field>
    </record>

    <record id="medical_diagnostic_view_filter" model="ir.ui.view">
        <field name="name">medical_diagnostic.view.filter</field>
        <field name="model">medical.diagnostic</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <search string="Search Diagnostic">
                <group expand="0" string="Group By">
                    <filter string="Name" name="name" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="medical_diagnostic_action"
            model="ir.actions.act_window">
        <field name="name">Medical diagnostic</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medical.diagnostic</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_id"
               ref="medical_diagnostic_view_tree"/>
        <field name="search_view_id"
               ref="medical_diagnostic_view_filter"/>
    </record>

    <record model="ir.ui.menu" id="medical_diagnostic_menu">
        <field name="name">Medical diagnostic</field>
        <field name="parent_id" ref="contacts.res_partner_menu_config" />
        <field name="action" ref="medical_diagnostic_action" />
        <field name="sequence" eval="90" />
    </record>

    <record model="ir.actions.act_window" id="action_res_partner_diagnostic">
        <field name="name">Medical diagnostics</field>
        <field name="res_model">medical.diagnostic</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_res_ids': active_ids}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('medical_diagnostic_view_tree')})]"
        />
        <field name="search_view_id" ref="medical_diagnostic_view_filter" />
        <field name="domain">[('res_partner_id', 'in', active_ids)]</field>
    </record>

    <record model="ir.ui.view" id="res_partner_medical_diagnostic_list_view">
        <field name="name">res.partner.medical.diagnostic.list.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    string="Medical diagnostic"
                    name="seta_extend_res_partner.action_res_partner_diagnostic"
                    type="action"
                    icon="fa-list"
                    context="{'default_res_partner_id': active_id}"
                >
                </button>
            </xpath>
        </field>
    </record>

</odoo>
