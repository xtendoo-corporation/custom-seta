<?xml version="1.0"?>
<odoo>
    <record id="res_partner_view_seta_foundation" model="ir.ui.view">
        <field name="name">res.partner.view.seta.foundation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[2]/field[@name='mobile']"
                position="after">
                <field name="company_phone" attrs="{'invisible': [('contact_type','=','school')]}"/>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']"
                position="after">
                <page name="personal_data" string="Personal data">
                    <group name="personal_data" string="Personal data">
                        <group name="birth_data">
                            <field name="birth_date" class="oe_inline"/>
                            <field name="birth_place" class="oe_inline"/>
                            <field name="contact_sex" class="oe_inline"/>
                            <field name="brothers_number" class="oe_inline"/>
                            <field name="user_state" class="oe_inline"/>
                            <field name="background" class="oe_inline"/>
                        </group>
                        <group name="others_data">
                            <field name="age" class="oe_inline"/>
                            <field name="allergies" class="oe_inline"/>
                            <field name="scholarships_and_grants" class="oe_inline"/>
                            <field name="observations" class="oe_inline"/>
                        </group>
                    </group>

                    <group name="others_datas" string="Otros datos">
                        <group name="type_data">
                            <field name="early_attention" class="oe_inline"/>
                            <field name="private" class="oe_inline"/>
                            <field name="origin_place" class="oe_inline"/>
                        </group>
                        <group name="dates_data">
                            <field name="derivation_date" class="oe_inline"/>
                            <field name="derivation_code" class="oe_inline"/>
                            <field name="nuhsa" class="oe_inline"/>
                        </group>
                    </group>
                    <group name="discapacity_data" string="Discapacity">
                        <group>
                            <field name="discapacity" class="oe_inline"/>
                        </group>
                        <group>
                            <field name="grade_of_discapacity"
                                   attrs="{'invisible': [('discapacity','=',False)]}"
                                   class="oe_inline"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='function']"
                position="before">
                <field name="address" class="oe_inline" attrs="{'invisible': [('type', '!=', 'contact') ]}"/>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='function']"
                position="after">
                <field name="company"
                       attrs="{'invisible': ['|',('contact_type','=','school'),('type', '!=', 'contact')]}"/>
                <field name="birth_date"
                       attrs="{'invisible': ['|',('contact_type','=','school'),('type', '!=', 'contact')]}"/>
                <field name="age"
                       attrs="{'invisible': ['|',('contact_type','=','school'),('type', '!=', 'contact') ]}"/>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='function']"
                position="attributes">

                <attribute
                    name="attrs">{'invisible':['|',('contact_type','=','school'),('type', '!=', 'contact')]}
                </attribute>
            </xpath>

            <xpath
                expr="//div[@class='oe_kanban_details']/field[@name='name']"
                position="before">
                <field name="contact_type" class="badge rounded-pill bg-success bg-info text-white fw-bold fs-6"
                       attrs="{'invisible': ['|',('is_company', '=', True),('contact_type', '=', 'other')]}"/>
                <br/>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[1]/field[@name='title']"
                position="attributes">
                <attribute
                    name="attrs">{'invisible':True}
                </attribute>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]"
                position="before">
                <group>
                    <field name="contact_type" attrs="{'invisible': [('type', '!=', 'contact')]}"/>
                </group>
            </xpath>

            <xpath
                expr="//field[@name='vat']" position="after">
                <field name="contact_type" attrs="{'invisible': [('company_type', '==', 'company')]}"/>
                <field name="group_id" attrs="{'invisible': [('company_type', '==', 'company')]}"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Early attention" name="early_attention" domain="[('early_attention', '=', True)]"/>
                <filter string="Private attention" name="private" domain="[('private', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

</odoo>
