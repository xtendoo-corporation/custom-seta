<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_attendance_record" model="ir.actions.act_window">
        <field name="name">Attendance Records</field>
        <field name="res_model">attendance.record</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>

    <record id="view_attendance_record_form" model="ir.ui.view">
        <field name="name">attendance.record.form</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <sheet>
                    <group>
                        <field name="group_id"/>
                        <field name="activity"/>
                        <field name="create_date"/>
                        <field name="attendance_record_line_ids">
                            <tree editable="bottom">
                                <field name="student_id"/>
                                <field name="present"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attendance_record_tree" model="ir.ui.view">
        <field name="name">attendance.record.tree</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <tree string="Attendance Records">
                <field name="activity"/>
                <field name="group_id"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_attendance_record_calendar" model="ir.ui.view">
        <field name="name">attendance.record.calendar</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Calendar" date_start="create_date" date_stop="create_date" color="color">
                <field name="activity"/>
                <field name="group_id"/>
                <field name="create_date"/>
                <field name="student_names" string="Students"/>
            </calendar>
        </field>
    </record>

    <menuitem id="menu_attendance_record" name="Attendance Records"
              parent="contacts.menu_contacts"
              action="action_attendance_record"
              sequence="30"/>

    <record id="view_attendance_record_line_form" model="ir.ui.view">
        <field name="name">attendance.record.line.form</field>
        <field name="model">attendance.record.line</field>
        <field name="arch" type="xml">
            <form string="Attendance Record Line">
                <sheet>
                    <group>
                        <field name="attendance_record_id"/>
                        <field name="student_id"/>
                        <field name="present"/>
                    </group>
                    <group>
                        <field name="activity" readonly="1" invisible="1"/>
                        <field name="group_id" readonly="1" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attendance_record_line_tree" model="ir.ui.view">
            <field name="name">attendance.record.line.tree</field>
            <field name="model">attendance.record.line</field>
            <field name="arch" type="xml">
                <tree string="Attendance Record Lines">
                    <field name="attendance_record_id" invisible="1"/>
                    <field name="student_id"/>
                    <field name="present"/>
                    <field name="activity"/>
                    <field name="group_id"/>
                </tree>
            </field>
        </record>
</odoo>
