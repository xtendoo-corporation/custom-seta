<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_contact_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">contact.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_contact_group_form" model="ir.ui.view">
        <field name="name">contact.group.form</field>
        <field name="model">contact.group</field>
        <field name="arch" type="xml">
            <form string="Contact Group">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contact_ids" options="{'no_create': True}"
                               domain="[('is_company', '=', False), ('group_id', '=', False), ('contact_type', '=', 'student')]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contact_group_tree" model="ir.ui.view">
        <field name="name">contact.group.tree</field>
        <field name="model">contact.group</field>
        <field name="arch" type="xml">
            <tree string="Contact Groups">
                <field name="name"/>
                <field name="contact_ids" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_contact_group" name="Groups"
              parent="contacts.menu_contacts"
              action="action_contact_group"
              sequence="20"/>

    <record id="attendance_record_action_contact_filtered" model="ir.actions.act_window">
        <field name="name">Asistencias</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">attendance.record.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('student_id', '=', active_id)]</field>
    </record>

    <record id="view_partner_form_inherit_attendance" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.attendance</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
            <button name="seta_groups_and_attendance.attendance_record_action_contact_filtered"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-list"
                    string="Asistencias">
                 <field name="attendance_count" widget="statinfo" string="Attendance Records"/>
            </button>
        </xpath>
    </field>
</record>

</odoo>
